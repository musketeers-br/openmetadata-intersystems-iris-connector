+@compiles(MedianFn, Dialects.Iris)
+def _(elements, compiler, **kwargs):
+    """
+    IRIS median: the MySQL window form, adapted. IRIS has no percentile function (SQLCODE -359), ROUND needs two
+    arguments, an unqualified table name resolves in SQLUser, and a bare column name inside the scalar subquery
+    binds to the outer row. So the subquery reads the FROM element of the enclosing query (the schema-qualified
+    table, or the sample when the profile is sampled), aliases the inner value and leaves NULLs out.
+    """
+    if len(elements.clauses.clauses) > 3:
+        raise CompileError("The dimensional (GROUP BY) median is not supported on IRIS")
+    col = compiler.process(elements.clauses.clauses[0], **kwargs)
+    table = elements.clauses.clauses[1].value
+    percentile = elements.clauses.clauses[2].value
+
+    froms = list(compiler.stack[-1].get("correlate_froms", ())) if compiler.stack else []
+    source = next((f for f in froms if getattr(f, "name", None) == table), froms[0] if len(froms) == 1 else None)
+    if source is None:
+        raise CompileError(f"IRIS median: cannot tell which table to read for {table}")
+    if getattr(source, "schema", None):
+        from_clause = compiler.preparer.format_table(source)
+    else:
+        from_clause = compiler.preparer.quote(source.name)
+    return (
+        f"(SELECT temp.median_value FROM (SELECT {col} AS median_value, "
+        f"ROW_NUMBER() OVER (ORDER BY {col}) AS row_num, COUNT(*) OVER () AS total_count "
+        f"FROM {from_clause} WHERE {col} IS NOT NULL) temp "
+        f"WHERE temp.row_num = ROUND({percentile} * temp.total_count, 0))"
+    )
+
